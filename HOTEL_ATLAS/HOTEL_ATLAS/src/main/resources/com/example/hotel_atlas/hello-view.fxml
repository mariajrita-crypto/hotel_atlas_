<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1280.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.hotel.HotelController">
    <left>
        <VBox prefWidth="220.0" spacing="10.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
            </padding>
            <children>
                <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="HOTEL ATLAS" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Dashboard" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Reservas" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Quartos" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Hóspedes" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Financeiro" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox spacing="15.0">
                    <children>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="card-stat-title" text="Total de Quartos" />
                                <Label fx:id="lblQuartosTotais" styleClass="card-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="card-stat-title" text="Disponíveis" />
                                <Label fx:id="lblQuartosDisponiveis" styleClass="card-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="card-stat-title" text="Ocupados" />
                                <Label fx:id="lblQuartosOcupados" styleClass="card-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="card-stat-title" text="Reservados" />
                                <Label fx:id="lblQuartosReservados" styleClass="card-stat-value" text="0" />
                            </children>
                        </VBox>
                        <VBox styleClass="card-stat" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="card-stat-title" text="Em Manutenção" />
                                <Label fx:id="lblQuartosManutencao" styleClass="card-stat-value" text="0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Calendário de Ocupação" />
                                <DatePicker fx:id="dpDataInicioCalendario" />
                            </children>
                        </HBox>
                        <ScrollPane fitToHeight="true" fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <GridPane fx:id="gridCalendario" hgap="2.0" vgap="2.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>